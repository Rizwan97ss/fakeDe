# --- C++ engine ---
engine/vcpkg/
engine/vcpkg_installed/
engine/onnxruntime/
engine/build/
engine/out/
# Everything under models/ is fetched/generated by scripts/fetch_models.ps1 -
# nothing here is ever committed, not even the small tokenizer vocab/merges files,
# so "models/ is entirely generated" stays a simple, exceptionless invariant.
engine/models/**
engine/scripts/export_to_onnx/.venv/
engine/scripts/export_to_onnx/__pycache__/
*.obj
*.o
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# --- React frontend ---
web/node_modules/
web/dist/
web/.vite/
web/*.local

# --- Data ---
*.sqlite
*.sqlite3
*.db

# --- OS / editor ---
.vs/
.vscode/
.claude/
*.user
Thumbs.db
.DS_Store
